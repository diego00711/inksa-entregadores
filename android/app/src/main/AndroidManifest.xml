<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Serviço de turno: mantém o entregador online com o app fechado.
             O "porquê" inteiro está no cabeçalho do HeartbeatService.java.

             O TIPO É "location" DE PROPÓSITO, e não "dataSync": desde o Android
             15 o dataSync morre depois de 6 horas por dia, no meio de um turno.

             ⚠️ ESTE TIPO PRECISA SER DECLARADO NO PLAY CONSOLE
             (App content → Foreground service types), com descrição e vídeo,
             senão a publicação é recusada. -->
        <service
            android:name=".HeartbeatService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Ícone da barra de status do Android. Sem isto o sistema usa o
             ícone do app, que é colorido: o Android transforma qualquer coisa
             não-monocromática num QUADRADO BRANCO na barra. O ic_stat_inksa é
             a silhueta branca com os vazados preservados.
             A cor tinge o ícone e o cabeçalho da notificação. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_inksa" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/ic_launcher_background" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Localização do entregador (GPS) para rastreamento das entregas -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Push: o @capacitor/push-notifications PEDE esta permissão em tempo de
         execução (Android 13+), mas NÃO a declara no manifesto dele. Sem esta
         linha o pedido é negado na hora, sem mostrar o diálogo. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Serviço de turno. A partir do Android 14 não basta FOREGROUND_SERVICE:
         cada TIPO usado exige a sua própria permissão, e faltando ela o app
         estoura SecurityException na hora de entrar em primeiro plano.

         NÃO pedimos ACCESS_BACKGROUND_LOCATION: serviço em primeiro plano
         iniciado com o app aberto já lê posição em segundo plano, e aquela
         permissão dispararia a revisão pesada do Google sem nos dar nada. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
</manifest>
